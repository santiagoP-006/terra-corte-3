# Funciones definidas por el usuario

funcion intensidad_carbono(co2, poblacion):
    si poblacion <= 0.0:
        retornar nulo
    fin
    retornar co2 / poblacion * 1000000.0
fin

funcion nivel_intensidad(valor):
    si valor > 4.0:
        retornar "alta"
    sino si valor > 2.0:
        retornar "media"
    fin
    retornar "baja"
fin

funcion factorial_recursivo(n):
    si n <= 1:
        retornar 1
    fin
    retornar n * factorial_recursivo(n - 1)
fin

fijo indice = intensidad_carbono(88.1, 52300000.0)
mostrar("Intensidad:", redondear(indice, 3))
mostrar("Categoria:", nivel_intensidad(indice))
mostrar("Factorial de 5:", factorial_recursivo(5))
