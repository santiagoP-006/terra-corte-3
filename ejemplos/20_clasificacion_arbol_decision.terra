# ejemplos/20_clasificacion_arbol_decision.terra
# Clasificacion de niveles de emision con arbol de decision

# Datos de entrenamiento: [co2_per_capita, energia_renovable]
fijo X_train = [[1.68, 26.4],[1.91, 27.1],[2.03, 29.3],[1.72, 28.1],[1.44, 24.8],[1.81, 25.6],[1.50, 27.2],[1.62, 26.9],[4.41, 31.2],[4.72, 34.5],[4.35, 41.8],[4.34, 38.2],[2.38, 22.1],[2.42, 23.4],[2.07, 25.0],[2.17, 24.6]
]

fijo y_train = [
    "moderada", "moderada", "moderada", "moderada",
    "moderada", "moderada", "moderada", "moderada",
    "alta",     "alta",     "alta",     "alta",
    "media",    "media",    "media",    "media"
]

# Entrenar el arbol con profundidad maxima 3
fijo modelo = arbol_decision(X_train, y_train, 3)
mostrar(modelo)

# Visualizar la estructura
mostrar_arbol(modelo, ["co2_per_capita", "energia_renovable"])

# Clasificar observaciones nuevas
fijo nueva = [1.75, 27.0]
mostrar("Clasificacion:", clasificar(modelo, nueva))

fijo nuevas = [[1.75, 27.0], [4.5, 35.0], [2.3, 24.0]]
mostrar("Clasificaciones:", clasificar_lote(modelo, nuevas))

# Evaluar sobre los mismos datos de entrenamiento
fijo resultado = evaluar_arbol(modelo, X_train, y_train)
mostrar(resultado)
mostrar("Exactitud:", exactitud(resultado))