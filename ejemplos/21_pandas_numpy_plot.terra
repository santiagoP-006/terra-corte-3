# =====================================================================
# PANDAS — DataFrames
# =====================================================================

fijo datos = cargar "datos/emisiones_ejemplo.csv"
fijo df    = desde_tabla(datos)

info_df(df)

mostrar(head(df, 3))
mostrar(tail(df, 3))

fijo df2 = reemplazar(df, "pais", "Colombia", "COL")
mostrar(head(df2, 2))

fijo mat_corr = correlacion(df)
mostrar(mat_corr)

fijo largo = melt(df, ["pais", "anio"], "indicador", "valor")
mostrar(head(largo, 5))

# =====================================================================
# NUMPY — Arrays y algebra lineal
# =====================================================================

fijo v = array([1.0, 2.0, 3.0])
mostrar(v)

fijo A = array([[1.0, 2.0], [3.0, 4.0]])
fijo B = array([[5.0, 6.0], [7.0, 8.0]])

mostrar("A + B:")
mostrar(sumar_arrays(A, B))

mostrar("A @ B (producto matricial):")
mostrar(producto_mat(A, B))

mostrar("Transpuesta de A:")
